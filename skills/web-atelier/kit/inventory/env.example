
# ── Live stock (src/lib/inventory) ─────────────────────────────────────────────
# Source: demo | sheets | csv | json | supabase | shopify | woocommerce | square
INVENTORY_SOURCE=demo
INVENTORY_REVALIDATE=60          # seconds between automatic refreshes
INVENTORY_LOW_STOCK=3            # quantity at or below which "Last units" shows
INVENTORY_WEBHOOK_SECRET=        # long random string; enables POST /api/inventory/revalidate
INVENTORY_CURRENCY=EUR           # used when the source has no currency (WooCommerce)

# sheets / csv: Google Sheets → File → Share → Publish to web → CSV link
INVENTORY_CSV_URL=
# json: any endpoint returning [{ id, name, price, quantity | status, ... }]
INVENTORY_JSON_URL=
INVENTORY_JSON_TOKEN=
# supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
INVENTORY_TABLE=products
# shopify (Storefront API token)
SHOPIFY_STORE_DOMAIN=            # your-store.myshopify.com
SHOPIFY_STOREFRONT_TOKEN=
# woocommerce (read-only REST key)
WC_STORE_URL=                    # https://shop.example.com
WC_CONSUMER_KEY=
WC_CONSUMER_SECRET=
# square (production access token, ITEMS_READ + INVENTORY_READ)
SQUARE_ACCESS_TOKEN=
SQUARE_ENV=production
